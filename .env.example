# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE=mongodb://localhost:27017/tafawoq

# Auth
JWT_SECRET=change-me

# URLs (used for CORS, redirects, and email links)
FRONTEND_URL=http://localhost:3000
WEBSITE_URL=http://localhost:3000

# Email (Resend — https://resend.com)
RESEND_API_KEY=
# Must be a verified domain/sender in your Resend account, e.g. "Tafawoq <noreply@yourdomain.com>".
# The default onboarding@resend.dev sender only works for testing and only
# delivers to the email address on your own Resend account.
RESEND_FROM_EMAIL=Tafawoq <onboarding@resend.dev>

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Jitsi (video sessions)
JITSI_BASE_URL=

# AI landing-page assistant (server-side only, never exposed to the client)
GROQ_API_KEY=
